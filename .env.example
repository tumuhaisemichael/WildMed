# MySQL connection used by the Next.js review API
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wildmed_user
DB_PASSWORD=replace_with_a_strong_password
DB_NAME=wildmed

# Long, random secret entered on /admin/reviews
REVIEW_ADMIN_TOKEN=replace_with_a_long_random_secret

# Where reviews are stored: "json" = JSON file only (no database needed), "both" = database and JSON file
REVIEW_STORAGE=both
# JSON copy of every review, kept alongside the database (defaults to data/reviews.json in the project)
REVIEWS_JSON_PATH=

# Hostinger email used by /api/enquiry to send website form submissions
# Port 465 uses SSL; use 587 if your host requires STARTTLS instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@yourdomain.com
SMTP_PASSWORD=Amayah2019$$

# Inbox that receives enquiries (defaults to SMTP_USER when left empty)
ENQUIRY_TO=info@yourdomain.com
# Sender shown on enquiry emails; ENQUIRY_FROM must be SMTP_USER or an alias of it
ENQUIRY_FROM=info@yourdomain.com
ENQUIRY_FROM_NAME=WildMed Website

# Public address of the site, used for the admin link in new-review emails (e.g. https://wildmedug.com)
SITE_URL=
